# ─────────────────────────────────────────────────────────────────
#  AWS S3 Upload Server — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git!
# ─────────────────────────────────────────────────────────────────

# Your AWS IAM user credentials  (from IAM → Users → hcm-upload-bot → Security credentials)
AWS_ACCESS_KEY_ID=PASTE_YOUR_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_SECRET_ACCESS_KEY_HERE

# The region your S3 bucket is in  (e.g. ap-south-1 / us-east-1 / eu-west-1)
AWS_REGION=ap-south-1

# Your S3 bucket name  (the one you created, e.g. hcm-licence-uploads)
S3_BUCKET_NAME=hcm-document-rag-2026

# Port this server listens on  (leave as 3001 unless something is already using it)
PORT=3001

# Frontend origin for CORS  (change to your deployed domain when you go live)
FRONTEND_ORIGIN=http://localhost:5173
